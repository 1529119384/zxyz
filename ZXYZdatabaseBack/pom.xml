<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- Boot 4 迁移（ISSUE/48，2026-10-09）：3.5.14 → 4.0.8 ⇒ 自带 spring-framework 7.0.9（CVE-2026-47884/47890/47892 唯一修复版） -->
        <version>4.0.8</version>
        <relativePath/>
    </parent>

    <groupId>uno.acloud</groupId>
    <artifactId>zxyz-backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>zxyz-backend</name>
    <description>ZXYZ backend multi-module parent</description>

    <modules>
        <module>zxyz-common</module>
        <module>zxyz-starter</module>
        <module>zxyz-gateway</module>
        <module>zxyz-project-service</module>
        <module>zxyz-im-service</module>
        <module>zxyz-email-service</module>
        <module>zxyz-share-service</module>
        <module>zxyz-file-service</module>
        <module>zxyz-team-service</module>
        <module>zxyz-user-service</module>
        <module>zxyz-audit-service</module>
        <module>zxyz-admin-service</module>
    </modules>

    <properties>
        <!-- Boot 4 迁移：17 → 21（Boot 4 官方要求 ≥17、验证至 26；选 21 LTS 配 temurin-21 镜像，ISSUE/48 R8） -->
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <sa-token.version>1.46.0</sa-token.version>
        <redisson.version>3.35.0</redisson.version>
        <mybatis-plus.version>3.5.17</mybatis-plus.version>
        <!-- Boot 4 迁移：2.8.9 → 3.0.3（springdoc 3.0.x 配 Boot 4.0.x；3.1.x 配 4.1.x，ISSUE/48 D5）；knife4j 移除（停更 + 与 Boot 4 互斥，dev 用 springdoc 自带 swagger-ui，用户已拍板） -->
        <springdoc.version>3.0.3</springdoc.version>
        <aliyun-oss-v2.version>0.6.0</aliyun-oss-v2.version>
        <commons-lang3.version>3.20.0</commons-lang3.version>
        <lombok.version>1.18.42</lombok.version>
        <simple-java-mail.version>9.3.5</simple-java-mail.version>
<!-- m54: MapStruct — 对象映射框架，逐步替代手动字段拷贝 -->
        <mapstruct.version>1.6.3</mapstruct.version>
        <testcontainers.version>1.21.4</testcontainers.version>
        <!-- Boot 4 迁移（ISSUE/48 §二，2026-10-09）：SC 2025.0.3 → 2025.1.3（Oakwood train，官方配 Boot 4.0.x）；
             SCA 2025.0.0.0 → 2025.1.0.0（BOM parent = spring-cloud-dependencies-parent 5.0.0，与 SC 2025.1 同代） -->
        <spring-cloud.version>2025.1.3</spring-cloud.version>
        <spring-cloud-alibaba.version>2025.1.0.0</spring-cloud-alibaba.version>
        <!-- Boot 4 迁移：2.2.0 → 2.4.0 且坐标换 resilience4j-spring-boot4（Central 实测 latest） -->
        <resilience4j.version>2.4.0</resilience4j.version>
        <!-- Boot 4 迁移（ISSUE/48 §九）：3.0.5 starter → 1.9.3 纯内核；starter 壳绑旧 spring-cloud-context，
             自建 StringEncryptor Bean + ENC() 属性解析钩子替代；算法/密钥/密文零迁移 -->
        <jasypt.version>1.9.3</jasypt.version>
        <!-- D5 架构约束测试（路线 B：只钉现状 + FreezingArchRule 冻结存量违规）：
             ArchUnit 的 @AnalyzeClasses 只能看到「测试模块自己的 classpath」，而本仓每个服务都是
             独立 Maven 模块、没有任何模块依赖其他服务 ⇒ 不存在能「看到全部服务」的模块。
             因此规则不按模块分片，而是用 ClassFileImporter 直接读取各模块的 target/classes，
             集中挂在 reactor 的最后一个模块 zxyz-admin-service 下（见
             zxyz-admin-service/src/test/java/uno/acloud/admin/architecture/ArchitectureRulesTest.java）。
             版本只在根 pom 声明一次，便于将来若要改走路线 A（新建 zxyz-arch-test 模块）时直接复用。 -->
        <archunit.version>1.5.0</archunit.version>

        <!-- ===== 后端覆盖率棘轮（门禁）=====
             实现：jacoco-maven-plugin 的 `check` goal，见下方 <build><plugins>；各模块用自己的
             <properties> 覆盖 <jacoco.line.min> 设定各自的 LINE 下界。
             ⚠️ 两个刻意的设计决定，改之前先读 ISSUE/10-TESTING-STRATEGY.md §1.0：
             1) `check` 显式绑到 **test** 阶段（jacoco 默认是 verify）—— 本仓 CI 跑的是
                `mvn -B test`，绑 verify 会让门禁**永不执行**（本仓反复踩过的"假绿灯"）。
             2) 阈值必须按 **"仅单测"** 实测值 − 约 4 点设，**不可按 CI（含集成测试）基线**：
                TOTAL 两侧差 6.63pt > 4pt 余量 ⇒ 用 CI 基线设会在集成测试被跳过时集体假红。
             本属性只是兜底默认（0 = 不设下界），真实阈值在 11 个业务模块的 <properties> 里。 -->
        <jacoco.line.min>0.00</jacoco.line.min>

        <!-- ===== 安全漏洞修复覆盖：以下属性覆盖 Spring Boot 4.0.8 自带
             dependency management 中仍低于修复版的依赖（Trivy HIGH/CRITICAL）。
             全部为 Spring Boot dependencies 已有的同名属性，仅调高版本号，
             不改 pom 结构。版本均经 Maven Central 200 校验。

             Boot 4 迁移（ISSUE/48 §8.7.3/R9，2026-10-09）注记：
             · 删除的钉版（Boot 4.0.8 管理值已覆盖或更优）：netty（→4.2.17.Final）、tomcat（→11.0.24）、
               spring-framework（→7.0.9）、spring-data-bom（→2025.1.7）、micrometer（→1.16.7）、
               flyway（→11.14.1）、jaxb-runtime（glassfish-jaxb 4.0.9 ≥ 原 4.0.5 钉版）；
             · Jackson 属性改名：Boot 4 的 jackson-bom.version 语义变为 Jackson 3 BOM，
               Jackson 2 CVE 钉版迁移至 jackson-2-bom.version（本仓 88 个 main 文件的 com.fasterxml 代码依赖此轨）；
             · spring-retry 脱离 Boot 4 BOM 管理 ⇒ 显式钉版（D2，见 spring-retry.version）；
             · 保留钉版：httpcore5 / rabbit-amqp-client / redisson / testcontainers / archunit。 ===== -->
        <!-- jackson 2.21.2 → 2.21.7：原 2.21.4 修复了 GHSA-r7wm-3cxj-wff9 / CVE-2026-54512；
             2026-10-07 再升至 2.21.7 —— Trivy 在 2.21.4 上报出 5 个可修复 HIGH（ignore-unfixed 下仍拦部署）：
               · jackson-core    CVE-2026-89407（正则回溯 DoS）、CVE-2026-89425（畸形 token 致 StringBuilder 无界增长）
               · jackson-databind CVE-2026-68497（数值解析无界 DoS，修复版 2.21.6）
               · CVE-2026-91776 / CVE-2026-91777（jackson-core，修复版 2.21.7）
             2.21.7 同时覆盖上述全部（databind 的 2.21.6 亦已含在内）。Jackson 2.x 二进制兼容。
             ⚠️ Boot 4 下属性名为 jackson-2-bom.version（jackson-bom.version 已是 Jackson 3 BOM，勿用）。 -->
        <jackson-2-bom.version>2.21.7</jackson-2-bom.version>
        <!-- CI 首跑实证（ISSUE/48 §11.4，run 37914492630 security-scan）：Boot 4 引入的
             Jackson 3 轨（tools.jackson 3.1.5）报 5 个可修复 HIGH（与 Jackson 2 轨当年同型）：
               · jackson-core    CVE-2026-89407、CVE-2026-89425（修复 3.1.7 / 3.2.x）
               · jackson-databind CVE-2026-68497、CVE-2026-91776、CVE-2026-91777（修复 3.1.6/3.1.7）
             钉 jackson-bom.version=3.1.7（Boot 自有属性名，BOM 内 core/databind 统一 3.1.7），
             3.1.x 线内补丁升级、二进制兼容。 -->
        <jackson-bom.version>3.1.7</jackson-bom.version>
        <!-- CI 首跑实证（同上）：tomcat-embed-core 11.0.24 报 3 个 CRITICAL
             （CVE-2026-65182/65905/68525，修复 11.0.25）；Boot 4.0.8 管理 11.0.24，
             按仓库既有「钉版高于管理版」模式钉 11.0.25。 -->
        <tomcat.version>11.0.25</tomcat.version>
        <!-- spring-retry：Boot 4.0.8 BOM 不再管理（BOM 属性块无此键），显式钉版（ISSUE/48 D2） -->
        <spring-retry.version>2.0.13</spring-retry.version>
        <!-- httpcore5 5.3.6 → 5.4.3（Boot 4.0.8 仅管 5.3.6，保留钉版） -->
        <httpcore5.version>5.4.3</httpcore5.version>
        <!-- rabbit amqp-client 5.25.0 → 5.35.0：CVE-2026-63337/69219（Boot 4.0.8 仅管 5.30.0，保留钉版） -->
        <rabbit-amqp-client.version>5.35.0</rabbit-amqp-client.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-alibaba-dependencies</artifactId>
                <version>${spring-cloud-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>uno.acloud</groupId>
                <artifactId>zxyz-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>uno.acloud</groupId>
                <artifactId>zxyz-common</artifactId>
                <version>${project.version}</version>
                <type>test-jar</type>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>uno.acloud</groupId>
                <artifactId>zxyz-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-extension</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <!-- 3.5.9 起 MybatisSqlSessionFactoryBean 等 Spring 集成类从 mybatis-plus-extension
                 拆到 mybatis-plus-spring（包名 com.baomidou.mybatisplus.spring）；
                 mybatis-plus-spring 传递依赖 mybatis-plus-extension，故两者同时可得。 -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-jsqlparser</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>com.aliyun</groupId>
                <artifactId>alibabacloud-oss-v2</artifactId>
                <version>${aliyun-oss-v2.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.dev33</groupId>
                <artifactId>sa-token-core</artifactId>
                <version>${sa-token.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.dev33</groupId>
                <artifactId>sa-token-spring-boot4-starter</artifactId>
                <version>${sa-token.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.dev33</groupId>
                <artifactId>sa-token-jwt</artifactId>
                <version>${sa-token.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.dev33</groupId>
                <artifactId>sa-token-redis-template</artifactId>
                <version>${sa-token.version}</version>
            </dependency>
            <!-- Sa-Token 独立 Redis 数据源（会话统一落 db9，与各服务业务库隔离）。
                 版本复用 ${sa-token.version}：Sa-Token 各组件必须同版本，
                 单独引第二个版本属性会让升级时漏改一处即出现运行时 NoSuchMethodError。
                 由 AloneRedisWiringContractTest 在 D 项钉住，勿改为字面量。
                 Boot 4 迁移：坐标改名 sa-token-alone-redis → sa-token-alone-redis-by-spring-boot4
                 （Central 实测 latest 1.46.0，与 boot3 系同版本号）。 -->
            <dependency>
                <groupId>cn.dev33</groupId>
                <artifactId>sa-token-alone-redis-by-spring-boot4</artifactId>
                <version>${sa-token.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.dev33</groupId>
                <artifactId>sa-token-reactor-spring-boot4-starter</artifactId>
                <version>${sa-token.version}</version>
            </dependency>
            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson</artifactId>
                <version>${redisson.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-spring-boot4</artifactId>
                <version>${resilience4j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-lang3</artifactId>
                <version>${commons-lang3.version}</version>
            </dependency>
            <!-- jaxb-runtime：本仓钉版已删（Boot 4.0.8 以 glassfish-jaxb.version=4.0.9 直接管理 org.glassfish.jaxb:jaxb-runtime，≥ 原 4.0.5 钉版） -->
            <dependency>
                <groupId>org.simplejavamail</groupId>
                <artifactId>simple-java-mail</artifactId>
                <version>${simple-java-mail.version}</version>
            </dependency>
            <!-- flyway：钉版已删，Boot 4.0.8 BOM 管理 flyway.version=11.14.1。
                 ⚠️ CI 首跑实证（run 37912603462）：Boot 4 把 FlywayAutoConfiguration 拆到独立
                 spring-boot-flyway 模块，仅声明 flyway-core（纯 Flyway 库）不会带来自动装配 ⇒
                 9 个服务的依赖已改用 spring-boot-starter-flyway（= spring-boot-flyway 自动装配
                 + flyway-core），flyway-mysql 方言仍需各服务显式声明（Boot 4 starter 不再传递）。 -->
            <!-- m54: MapStruct 对象映射框架，逐步替代手动字段拷贝（如 toTeamVO、toMemberVO 等）。
                 各服务模块需同时添加 mapstruct（编译期）和 mapstruct-processor（注解处理器）依赖。 -->
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers</artifactId>
                <version>${testcontainers.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>mysql</artifactId>
                <version>${testcontainers.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${testcontainers.version}</version>
                <scope>test</scope>
            </dependency>
            <!-- Jasypt 配置加密（Boot 4 迁移，ISSUE/48 §九）：starter 壳移除，改引 1.9.3 纯内核。
                 StringEncryptor Bean 与 ENC() 属性解析由 zxyz-common 自建钩子提供。 -->
            <dependency>
                <groupId>org.jasypt</groupId>
                <artifactId>jasypt</artifactId>
                <version>${jasypt.version}</version>
            </dependency>
            <!-- spring-retry：Boot 4 BOM 不再管理，显式定版（D2） -->
            <dependency>
                <groupId>org.springframework.retry</groupId>
                <artifactId>spring-retry</artifactId>
                <version>${spring-retry.version}</version>
            </dependency>
            <!-- bouncycastle bcprov-jdk18on 为传递依赖（如经 sa-token 等引入），
                 未在任意 pom 显式声明；此处显式定版以修复 CVE-2025-14813（CRITICAL），
                 覆盖到 ≥1.84（取 1.85，jdk18on 线）。 -->
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcprov-jdk18on</artifactId>
                <version>1.86</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- 共享依赖：所有模块（含 10 个 app 模块）继承。
         spring-boot-devtools：本地开发热部署（Debug 模式生效），
         optional 不传递、runtime 不参与编译，repackage 自动排除，不影响生产镜像。 -->
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.15</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                    <!-- 覆盖率门禁：逐模块校验 LINE 覆盖率下界（值见各模块 <properties> 的
                         jacoco.line.min）。⚠️ 必须显式绑 test —— jacoco `check` 的默认阶段是
                         verify，而本仓 CI 跑的是 `mvn -B test`，绑 verify 等于门禁永不执行
                         （本仓反复踩过的"假绿灯"）。 -->
                    <execution>
                        <id>check</id>
                        <phase>test</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.line.min}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
                <configuration>
                    <excludes>
                        <exclude>uno/acloud/*/*Application.class</exclude>
                        <exclude>uno/acloud/*/config/*AutoConfiguration*</exclude>
                        <exclude>uno/acloud/*/config/RestClientConfig.class</exclude>
                        <exclude>uno/acloud/starter/*AutoConfiguration*</exclude>
                        <exclude>uno/acloud/*/config/*Properties.class</exclude>
                        <exclude>uno/acloud/*/config/*DataSourceConfig.class</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <encoding>${project.build.sourceEncoding}</encoding>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                            <!-- m54: MapStruct 注解处理器，与 Lombok 配合使用 -->
                            <path>
                                <groupId>org.mapstruct</groupId>
                                <artifactId>mapstruct-processor</artifactId>
                                <version>${mapstruct.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <excludes>
                            <exclude>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </exclude>
                        </excludes>
                        <!-- 禁用 Nacos 客户端内置 logback，避免 Windows 上日志轮转 rename 失败 -->
                        <jvmArguments>-Dnacos.logging.default.config.enabled=false</jvmArguments>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
