{
  "name": "zxyzdatabase",
  "version": "0.0.0",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "typecheck": "vue-tsc --noEmit",
    "typecheck:scope": "node scripts/check-typecheck-scope.mjs",
    "colors:check": "node scripts/check-hardcoded-colors.mjs",
    "doc-count:check": "node scripts/check-doc-test-count.mjs",
    "size:check": "node scripts/check-bundle-size.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project=ui-mocked",
    "test:e2e:smoke": "playwright test --project=smoke-readonly",
    "test:e2e:list": "playwright test --list",
    "prepare": "husky"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@vueuse/core": "^14.4.0",
    "@zip.js/zip.js": "^2.15.0",
    "axios": "^1.20.0",
    "dompurify": "^3.4.15",
    "element-plus": "^2.11.7",
    "pinia": "^3.0.4",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitest/coverage-v8": "^5.0.0",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-vue": "^10.9.1",
    "globals": "^17.6.0",
    "happy-dom": "^20.10.2",
    "husky": "^9.1.7",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11"
  }
}
