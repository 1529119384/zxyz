# API 网关地址（开发环境默认端口 18000，可通过 .env.local 覆盖）
VITE_API_BASE_URL=http://localhost:18000
VITE_IM_API_BASE_URL=http://localhost:18000
# IM WebSocket 地址（默认端口 19090，可通过 .env.local 覆盖）
VITE_IM_WS_URL=ws://localhost:19090/ws
VITE_DEV_ALLOWED_HOSTS=natfrp.acloud.uno,.acloud.uno

# 开发期验证码回显（66 号 §三-14）：仅在 DEV 且此开关为 true 时才把验证码显示到界面
VITE_SHOW_DEV_VERIFY_CODE=true
