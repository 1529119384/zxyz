# ===== 环境与敏感文件 =====
.env
.env.*
!.env.example
# 前端环境配置（CI 构建需要）
!ZXYZdatabaseFront/.env.production
!ZXYZdatabaseFront/.env.development

# ===== IDE =====
.idea/
.vscode/
*.iml
*.ipr
*.iws
*.swp
.project
.classpath
.settings/

# ===== Java / Maven =====
**/target/
**/mvnw
**/mvnw.cmd
**/.mvn/

# ===== Node =====
**/node_modules/
**/dist/
**/dist-ssr/

# ===== Vite 自动生成的类型声明 =====
auto-imports.d.ts
components.d.ts
env.d.ts

# ===== 日志与临时文件 =====
**/*.log
**/logs/
**/*.zip
**/*.dump
**/*.tmp

# ===== 系统文件 =====
.DS_Store
Thumbs.db

# ===== 数据卷（Docker bind mount） =====
data/

# ===== 构建产物 =====
derby.log
nacos.home_IS_UNDEFINED/
query
ZXYZdatabaseFront/coverage/

# ===== 项目特定 =====
**/.claude/
**/.trae/
**/.workbuddy/
.codex-git-front
git-scratch-*
old/

# ===== TLS 证书 / 私钥（禁止提交；由 docker-compose.tls.yml 挂载到容器）=====
deploy/nginx/certs/*.pem
deploy/nginx/certs/*.crt
deploy/nginx/certs/*.key
deploy/nginx/certs/*.key.pem
deploy/nginx/certs/*.pfx
deploy/nginx/certs/*.cer
# 保留目录结构（.gitkeep 不受上述规则影响）
!deploy/nginx/certs/.gitkeep

# ===== Monorepo 安全网（防止子目录 .git/ 被误提交） =====
ZXYZdatabaseBack/.git/
ZXYZdatabaseFront/.git/
**/.git.bak/

# ===== 不纳入版本控制的目录 =====
ISSUE/
sql/schema_*.sql

# AI 协作产出的审计/收口报告（deliverables/engineering-assurance/**）。
# 与 ISSUE/、任务.md 同类：内容留在本地磁盘供人阅读，不入库（2026-09-22）。
# ⚠️ 必须忽略：未跟踪文件会令 pre-push 的子仓库同步检查把根仓视为"脏"从而拒推
#    （与 .last_ci_run 同一成因）。
deliverables/

# 用户手写的待办清单：本地磁盘保留，不入库（2026-09-21 取消跟踪）
任务.md

# 本地 CI 轮询产物（记录上次 run id）；未忽略会令 pre-push 的子仓库同步检查
# 把工作区视为"脏"从而拒推。
.last_ci_run

# ===== .qoder：只保留 rules，AI 生成的 repowiki 不再入库 =====
# repowiki = 311 文件 / 5.88 MB，纯 AI 生成的代码 wiki，且曾因"整目录豁免"造成 Gitleaks 311 文件盲区。
# 文件仍保留在本地磁盘，只是不再被 git 跟踪（见 ISSUE/24 §五 D-5）。
.qoder/repowiki/
