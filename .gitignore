# ===== 环境与敏感文件 =====
.env
.env.*
!.env.example
# 前端环境配置（CI 构建需要）
!ZXYZdatabaseFront/.env.production
!ZXYZdatabaseFront/.env.development

# ===== IDE =====
.idea/
.vscode/
*.iml
*.ipr
*.iws
*.swp
.project
.classpath
.settings/

# ===== Java / Maven =====
**/target/
**/mvnw
**/mvnw.cmd
**/.mvn/

# ===== Node =====
**/node_modules/
**/dist/
**/dist-ssr/

# ===== Vite 自动生成的类型声明 =====
auto-imports.d.ts
components.d.ts
env.d.ts

# ===== 日志与临时文件 =====
**/*.log
**/logs/
**/*.zip
**/*.dump
**/*.tmp

# ===== 系统文件 =====
.DS_Store
Thumbs.db

# ===== 数据卷（Docker bind mount） =====
data/

# ===== 构建产物 =====
derby.log
nacos.home_IS_UNDEFINED/
query
ZXYZdatabaseFront/coverage/

# ===== 项目特定 =====
**/.claude/
**/.trae/
**/.workbuddy/
.codex-git-front
git-scratch-*
old/

# ===== TLS 证书 / 私钥（禁止提交；由 docker-compose.tls.yml 挂载到容器）=====
deploy/nginx/certs/*.pem
deploy/nginx/certs/*.crt
deploy/nginx/certs/*.key
deploy/nginx/certs/*.key.pem
deploy/nginx/certs/*.pfx
deploy/nginx/certs/*.cer
# 保留目录结构（.gitkeep 不受上述规则影响）
!deploy/nginx/certs/.gitkeep

# ===== Monorepo 安全网（防止子目录 .git/ 被误提交） =====
ZXYZdatabaseBack/.git/
ZXYZdatabaseFront/.git/
**/.git.bak/

# ===== 不纳入版本控制的目录 =====
ISSUE/
sql/schema_*.sql

# 本地 CI 轮询产物（记录上次 run id）；未忽略会令 pre-push 的子仓库同步检查
# 把工作区视为"脏"从而拒推。
.last_ci_run
