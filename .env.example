# -----------------------------------------------------------------------------
# ZXYZ Docker 部署环境变量模板
# 使用方式：
#   1. 复制本文件为 .env
#   2. 修改所有 CHANGE_ME 和与你服务器相关的配置
#   3. 不要把真实 .env 提交到仓库
# -----------------------------------------------------------------------------
#
# 【首次部署自动生成随机机密】
# 通过 CI/CD 部署（或手动运行 scripts/init-secrets.sh）时，下方所有「系统内部机密」
# （MYSQL_ROOT_PASSWORD / REDIS_PASSWORD / RABBITMQ_* / INTERNAL_SERVICE_TOKEN /
#  SHARE_COOKIE_SECRET / NACOS_* / JASYPT_PASSWORD / GRAFANA_ADMIN_PASSWORD /
#  EMAIL_CONFIG_SECRET）若为 CHANGE_ME_* 占位符，会被自动生成高强度随机值写入 .env
#  持久化；完整值仅记到服务器本地 init-secrets.log（chmod 600），终端只显示打码，不进
#  CI 公开日志。该步骤幂等——已有真实值不会被覆盖，可放心重复运行。
# ⚠️ 仍须手动填写：OSS 访问密钥、邮箱 SMTP 密码、前端地址等「外部凭证」（脚本不生成，
#   否则文件上传/邮件功能会静默失效），由 scripts/validate-env.sh 在生产门禁拦截。
# 本地快速体验可用：bash scripts/init-secrets.sh .env --dry-run 仅预览不写盘。

# 数据卷绑定挂载根目录。生产环境改为绝对路径，如 /opt/zxyz/data。
DATA_DIR=./data

# 镜像 tag，更新发布时可以改成日期或版本号，例如 20260513。
APP_IMAGE_TAG=latest

# 镜像前缀。本地构建留空；生产环境设为 registry 前缀以便拉取远程镜像。
# 重要：必须以 / 结尾（如 ghcr.io/owner/），否则 compose 拼接镜像名时会缺少分隔符。
# deploy 脚本会自动修正尾部斜杠，但手动设置时请注意。
IMAGE_PREFIX=

# 对外 HTTP 端口；已有宿主机 Nginx 时可改成 8080，再由宿主机 Nginx 反代。
HTTP_PORT=80

# MySQL root 密码。生产环境必须修改为高强度密码。
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_PASSWORD

# Redis 密码。生产环境必须修改为高强度密码。
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_DATABASE=0

# RabbitMQ 消息队列。管理界面默认 http://host:${RABBITMQ_MGMT_PORT}。
RABBITMQ_USER=CHANGE_ME_RABBITMQ_USER
RABBITMQ_PASSWORD=CHANGE_ME_RABBITMQ_PASSWORD
RABBITMQ_MGMT_PORT=15672

# Spring Boot 服务端口（容器内部，一般无需修改）
GATEWAY_PORT=18000
PROJECT_SERVICE_PORT=18080
IM_SERVICE_PORT=18081
EMAIL_SERVICE_PORT=18082
USER_SERVICE_PORT=18083
SHARE_SERVICE_PORT=18084
FILE_SERVICE_PORT=18085
TEAM_SERVICE_PORT=18086
AUDIT_SERVICE_PORT=18087
IM_NETTY_PORT=19090

# 后端服务间内部调用鉴权 token。所有后端服务间内部调用必须保持一致。
# 建议使用 32 位随机字符串。
INTERNAL_SERVICE_TOKEN=CHANGE_ME_INTERNAL_SERVICE_TOKEN

# 【可选·启用服务级白名单矩阵后使用】每服务独立密钥。
# 未配置时服务间仍用上述 INTERNAL_SERVICE_TOKEN（过渡兼容）；启用矩阵后，
# 每个服务用 SVC_<SERVICE>_KEY 作为自己的签发密钥，并作为 allowed-sources 的来源密钥下发到允许收方。
# 启用矩阵【必做·否则全员 401/500】：
#   ① 取消下面 SVC_* 注释并改为高强度随机串；
#   ② 在 docker-compose 每个服务 environment 增加 `APP_INTERNAL_SERVICE_KEY: ${SVC_<SERVICE>_KEY}`
#      （= 该服务自己的签发密钥；缺此则矩阵启用后发方仍持 legacy token 被收方拒）；
#   ③ 在收方 app.internal.allowed-sources 声明「来源服务名 -> 该来源 SVC_<SERVICE>_KEY」，
#      并【必须】把网关 admin 桥接也以 zxyz-gateway 来源列出（见各服务 application.yml 模板注释）。
# 注意：SVC_GATEWAY_KEY 必须与 gateway application.yml 里 admin-email 桥接注入的 token 一致，
#      否则矩阵启用后 admin 邮件管理经网关调用永远 401。密钥键禁 YAML 默认值；缺任一变量则对应服务拒绝启动（fail-closed）。
# 过渡窗口：未设 SVC_GATEWAY_KEY 时网关 admin 桥接回退 INTERNAL_SERVICE_TOKEN
#      （gateway 里写作 ${SVC_GATEWAY_KEY:${INTERNAL_SERVICE_TOKEN}}，勿在生产长期依赖）。
# 【易漏一步】SVC_*_KEY 默认不在 compose 的 environment 列表里，容器看不到。启用矩阵时须在
#      docker-compose.yml 的 gateway 服务补 `SVC_GATEWAY_KEY: ${SVC_GATEWAY_KEY:?启用矩阵必须设置 SVC_GATEWAY_KEY}`
#      （用 :? 硬失败；写成普通 ${SVC_GATEWAY_KEY} 时变量缺失会变成空串、不回退，桥接将带空 token 401）。
# 完整步骤见 docs/matrix-enable-guide.md。
SVC_ADMIN_KEY=CHANGE_ME_SVC_ADMIN_KEY
SVC_AUDIT_KEY=CHANGE_ME_SVC_AUDIT_KEY
SVC_EMAIL_KEY=CHANGE_ME_SVC_EMAIL_KEY
SVC_FILE_KEY=CHANGE_ME_SVC_FILE_KEY
SVC_IM_KEY=CHANGE_ME_SVC_IM_KEY
SVC_PROJECT_KEY=CHANGE_ME_SVC_PROJECT_KEY
SVC_SHARE_KEY=CHANGE_ME_SVC_SHARE_KEY
SVC_TEAM_KEY=CHANGE_ME_SVC_TEAM_KEY
SVC_USER_KEY=CHANGE_ME_SVC_USER_KEY
SVC_GATEWAY_KEY=CHANGE_ME_SVC_GATEWAY_KEY

# 分享访问 Cookie 签名密钥。必须和 INTERNAL_SERVICE_TOKEN 不同。
SHARE_COOKIE_SECRET=CHANGE_ME_SHARE_COOKIE_SECRET

# 前端访问地址，用于生成分享链接。没有域名时先填 http://服务器IP。
FRONTEND_BASE_URL=http://YOUR_SERVER_IP

# 真实客户端 IP 无需任何配置项——由两处机制共同保证（2026-09-13 线上实测）：
#   1) zxyz-common 的 `server.forward-headers-strategy: native`：框架层即按
#      X-Forwarded-For 解析出 getRemoteAddr()；
#   2) deploy/nginx 在所有 /api location 上覆盖式写入
#      `X-Forwarded-For: $remote_addr` 与 `X-Real-IP: $remote_addr`；
#   3) 网关 ClientIpFilter 删除客户端自传的 XFF/X-Real-IP 后覆盖式回写解析结果。
# ⇒ 只要「业务服务与网关都不向宿主机发布端口」（本仓 compose 即如此，只有 frontend-nginx
#   与少量监控端口发布且绑 127.0.0.1），外部就无法绕过 nginx 伪造该头，限流天然按真实 IP 计数。
# 实测证据：4 个不同来源各打一次登录 → 落到 4 个不同限流桶，nginx/网关容器 IP 从未出现。
# 历史变量 GATEWAY_TRUSTED_PROXIES 已移除：它只影响网关自身的 XFF 走查，在本拓扑下
# 配与不配结果完全相同，留着会误导运维去配一个无效变量（连同 compose 接线、validate-env
# 检查、DEPLOYMENT 说明一并删除）。

# 阿里云 OSS 配置。文件上传、下载签名依赖这些值。
# ⚠️ OSS_PUBLIC_BASE_URL 的主机必须等于 `<OSS_BUCKET>.<OSS_ENDPOINT 主机>`，
#    因为 nginx CSP 的 connect-src 只放行它，而浏览器是直传到上面那个域名；
#    两者不一致会导致上传被 CSP 拦截（validate-env.sh 会校验）。
OSS_REGION=cn-shenzhen
OSS_BUCKET=your-bucket-name
OSS_ENDPOINT=https://oss-cn-shenzhen.aliyuncs.com
OSS_PUBLIC_BASE_URL=https://your-bucket-name.oss-cn-shenzhen.aliyuncs.com
OSS_ACCESS_KEY_ID=CHANGE_ME_OSS_ACCESS_KEY
OSS_ACCESS_KEY_SECRET=CHANGE_ME_OSS_ACCESS_SECRET

# 多存储配置。生产环境默认使用 OSS，本地存储仅用于开发/测试。
STORAGE_DEFAULT_PROVIDER=oss
STORAGE_OSS_ENABLED=true
STORAGE_LOCAL_ENABLED=false
LOCAL_STORAGE_PATH=./data/local-storage

# 邮件服务 SMTP 配置。若暂时不用邮件，仍建议保留占位值并设置 EMAIL_ENABLED=false。
EMAIL_ENABLED=true
EMAIL_ASYNC=true
EMAIL_HOST=smtp.qq.com
EMAIL_PORT=587
EMAIL_USERNAME=CHANGE_ME_SMTP_ACCOUNT
EMAIL_PASSWORD=CHANGE_ME_SMTP_AUTH_CODE
EMAIL_FROM=CHANGE_ME_SENDER_EMAIL
EMAIL_CONFIG_SECRET=CHANGE_ME_RANDOM_EMAIL_CONFIG_SECRET

# 前端允许的跨域来源。生产环境建议改为实际域名，例如 https://yourdomain.com。
CORS_ALLOWED_ORIGINS=CHANGE_ME_CORS_ORIGIN

# 生产环境默认关闭危险的数据库导入能力，需要时再显式改为 true。
DATABASE_MAINTENANCE_ENABLED=false

# 生产环境默认关闭开发期性能切面日志。
TIME_ASPECT_ENABLED=false

# Nacos 服务注册中心
NACOS_PORT=8848
# Nacos 登录用户名（默认 nacos，生产环境请改为非默认值）
NACOS_USERNAME=nacos
# Nacos 登录密码（默认 nacos，首次启动后建议通过控制台修改）
NACOS_PASSWORD=CHANGE_ME_NACOS_PASSWORD
# Nacos JWT 签名密钥，必须 Base64 编码，解码后 >=32 字节
# 生成方式: openssl rand -base64 32
NACOS_AUTH_TOKEN=CHANGE_ME_NACOS_AUTH_TOKEN
NACOS_AUTH_IDENTITY_KEY=serverIdentity
NACOS_AUTH_IDENTITY_VALUE=CHANGE_ME_NACOS_IDENTITY

# 加密配置属性密码（Jasypt）。用于加密 application.yml 中的敏感配置项。
JASYPT_PASSWORD=CHANGE_ME_JASYPT_PASSWORD

# Admin 管理服务
ADMIN_SERVICE_BASE_URL=http://admin-service:18088
ADMIN_SERVICE_PORT=18088

# 初始管理员引导（可选）。user-service 每次启动都会幂等地确保该账号存在。
# 不设 ADMIN_INIT_PASSWORD（留空）时，首次启动会随机生成 16 位字母数字密码，并在
#   docker logs zxyz-user-service 中 grep "初始管理员" 获取明文（仅打印一次，请立即登录修改）。
# 生产环境建议在部署前在此显式设置 ADMIN_INIT_PASSWORD 为高强度密码。
ADMIN_INIT_USERNAME=
ADMIN_INIT_PASSWORD=

# -----------------------------------------------------------------------------
# 数据库最小权限专用账户（对应缺陷 U1：避免所有服务用 root 直连=全库 DBA）
# 为每个业务库创建「仅限本库 + 单库 DDL」的专属账户，取代 root。
# 用户名固定默认值见下；密码为 CHANGE_ME_* 占位符，首次部署由 scripts/init-secrets.sh
#   自动生成高强度随机值写入 .env（完整值落本地 init-secrets.log，chmod 600）。
# 【已启用】docker-compose.yml 各服务已改为引用 ${PROJECT_DB_USERNAME:?...} 等
#   （Nacos 用 ${NACOS_DB_USERNAME:?...}）。变量缺失或仍为占位符时 compose 直接报错，
#   不会静默回退 root —— 静默回退会重新引入本缺陷，故采用 fail-fast。
# 【部署顺序】由流水线保证：① init-secrets.sh 生成凭据 → ② grant-least-privilege.sh
#   在 MySQL 容器中建账户（部署前自动执行）→ ③ docker compose up。手工 up 前请先跑前两步。
# 【如确需回退 root（不推荐）】把对应 <PREFIX>_DB_USERNAME 设为 root、<PREFIX>_DB_PASSWORD
#   设为与 MYSQL_ROOT_PASSWORD 相同的值（compose 不支持嵌套 ${A:-${B}}，故必须显式写同值）。
# -----------------------------------------------------------------------------
# 配置中心数据库（zxyz_config）
CONFIG_DB_HOST=mysql
CONFIG_DB_USERNAME=zxyz_config
CONFIG_DB_PASSWORD=CHANGE_ME_CONFIG_DB_PASSWORD

# 业务库专用账户（用户名固定默认；密码占位，由 init-secrets.sh 生成）
PROJECT_DB_USERNAME=zxyz_project
PROJECT_DB_PASSWORD=CHANGE_ME_PROJECT_DB_PASSWORD
IM_DB_USERNAME=zxyz_im
IM_DB_PASSWORD=CHANGE_ME_IM_DB_PASSWORD
EMAIL_DB_USERNAME=zxyz_email
EMAIL_DB_PASSWORD=CHANGE_ME_EMAIL_DB_PASSWORD
SHARE_DB_USERNAME=zxyz_share
SHARE_DB_PASSWORD=CHANGE_ME_SHARE_DB_PASSWORD
FILE_DB_USERNAME=zxyz_file
FILE_DB_PASSWORD=CHANGE_ME_FILE_DB_PASSWORD
TEAM_DB_USERNAME=zxyz_team
TEAM_DB_PASSWORD=CHANGE_ME_TEAM_DB_PASSWORD
AUDIT_DB_USERNAME=zxyz_audit
AUDIT_DB_PASSWORD=CHANGE_ME_AUDIT_DB_PASSWORD
USER_DB_USERNAME=zxyz_user
USER_DB_PASSWORD=CHANGE_ME_USER_DB_PASSWORD
# Nacos 自带库（nacos），在 compose 中以 MYSQL_SERVICE_USER / MYSQL_SERVICE_PASSWORD 引用
NACOS_DB_USERNAME=zxyz_nacos
NACOS_DB_PASSWORD=CHANGE_ME_NACOS_DB_PASSWORD

# Sa-Token 认证配置（Cookie + Token 超时）
# ⚠️ AUTH_COOKIE_SECURE：当前部署为 IP 直连 HTTP，故为 false（true 会使浏览器不回传
#    Secure Cookie → 登录失效）。启用 HTTPS（容器内 nginx 443 + 证书，见 DEPLOYMENT.md
#    「TLS 终止」章节）后，必须改为 true，否则会话 Cookie 可被嗅探。
AUTH_COOKIE_SECURE=false
# TLS 终止开关：默认 false（站点 IP 直连 HTTP）。
# 置 true 需配合 docker-compose.tls.yml 覆盖（容器内 nginx 监听 443 + 挂载证书），
# 并同步把 AUTH_COOKIE_SECURE 改为 true。validate-env 会校验二者一致性。
TLS_ENABLED=false
AUTH_COOKIE_DOMAIN=
AUTH_TOKEN_TIMEOUT=43200
AUTH_LONG_LIVED_TIMEOUT=604800

# -----------------------------------------------------------------------------
# 监控栈（Prometheus / Alertmanager / Grafana）
# 这些端口仅绑定 127.0.0.1（见 docker-compose.yml），生产请经宿主机 Nginx 反代并限制访问来源，切勿直接暴露公网。
# Grafana 默认 admin/admin 极危险，GRAFANA_ADMIN_PASSWORD 必须改为高强度密码。
# -----------------------------------------------------------------------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
ALERTMANAGER_PORT=9093
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# -----------------------------------------------------------------------------
# 告警投递渠道（Alertmanager，缺陷 U8）
# 由 scripts/render-alertmanager.sh 在部署时渲染到 deploy/alertmanager/alertmanager.yml。
# 两者皆留空时，告警路由合法但静默丢弃（监控不中断，优雅降级）。
# 至少配置其一即可让 Prometheus 告警真正送达：
#   - 通用 Webhook：直接接收 Alertmanager JSON 的端点（企业微信/钉钉需经适配网关转发）。
#   - 邮件：复用上方 EMAIL_* SMTP 配置，收件人为 ALERT_EMAIL_TO（需 EMAIL_ENABLED=true）。
# -----------------------------------------------------------------------------
# 通用 Webhook 机器人地址（如企业微信/钉钉自定义机器人需经适配网关）。留空则不启用 webhook 渠道。
ALERT_WEBHOOK_URL=
# 邮件告警收件人地址。需 EMAIL_ENABLED=true 且上方 SMTP 已配置。留空则不走邮件渠道。
ALERT_EMAIL_TO=
