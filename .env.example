# -----------------------------------------------------------------------------
# ZXYZ Docker 部署环境变量模板
# 使用方式：
#   1. 复制本文件为 .env
#   2. 修改所有 CHANGE_ME 和与你服务器相关的配置
#   3. 不要把真实 .env 提交到仓库
# -----------------------------------------------------------------------------

# 数据卷绑定挂载根目录。生产环境改为绝对路径，如 /opt/zxyz/data。
DATA_DIR=./data

# 镜像 tag，更新发布时可以改成日期或版本号，例如 20260513。
APP_IMAGE_TAG=latest

# DockerHub 镜像前缀。本地构建留空；生产环境设为 yourname/ 以便从 DockerHub 拉取远程镜像。
# 重要：必须以 / 结尾（如 yourname/），否则 compose 拼接镜像名时会缺少分隔符。
# deploy 脚本会自动修正尾部斜杠，但手动设置时请注意。
DOCKERHUB_PREFIX=

# 对外 HTTP 端口；已有宿主机 Nginx 时可改成 8080，再由宿主机 Nginx 反代。
HTTP_PORT=80

# MySQL root 密码。生产环境必须修改为高强度密码。
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_PASSWORD

# Redis 密码。生产环境必须修改为高强度密码。
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_DATABASE=0

# RabbitMQ 消息队列。管理界面默认 http://host:${RABBITMQ_MGMT_PORT}。
RABBITMQ_USER=CHANGE_ME_RABBITMQ_USER
RABBITMQ_PASSWORD=CHANGE_ME_RABBITMQ_PASSWORD
RABBITMQ_MGMT_PORT=15672

# Spring Boot 服务端口（容器内部，一般无需修改）
GATEWAY_PORT=18000
PROJECT_SERVICE_PORT=18080
IM_SERVICE_PORT=18081
EMAIL_SERVICE_PORT=18082
USER_SERVICE_PORT=18083
SHARE_SERVICE_PORT=18084
FILE_SERVICE_PORT=18085
TEAM_SERVICE_PORT=18086
AUDIT_SERVICE_PORT=18087
IM_NETTY_PORT=19090

# 后端服务间内部调用鉴权 token。所有后端服务间内部调用必须保持一致。
# 建议使用 32 位随机字符串。
INTERNAL_SERVICE_TOKEN=CHANGE_ME_INTERNAL_SERVICE_TOKEN

# 分享访问 Cookie 签名密钥。必须和 INTERNAL_SERVICE_TOKEN 不同。
SHARE_COOKIE_SECRET=CHANGE_ME_SHARE_COOKIE_SECRET

# 前端访问地址，用于生成分享链接。没有域名时先填 http://服务器IP。
FRONTEND_BASE_URL=http://YOUR_SERVER_IP

# 阿里云 OSS 配置。文件上传、下载签名依赖这些值。
OSS_REGION=cn-shenzhen
OSS_BUCKET=your-bucket-name
OSS_ENDPOINT=https://oss-cn-shenzhen.aliyuncs.com
OSS_PUBLIC_BASE_URL=https://your-bucket.oss-cn-shenzhen.aliyuncs.com
OSS_ACCESS_KEY_ID=CHANGE_ME_OSS_ACCESS_KEY
OSS_ACCESS_KEY_SECRET=CHANGE_ME_OSS_ACCESS_SECRET

# 邮件服务 SMTP 配置。若暂时不用邮件，仍建议保留占位值并设置 EMAIL_ENABLED=false。
EMAIL_ENABLED=true
EMAIL_ASYNC=true
EMAIL_HOST=smtp.qq.com
EMAIL_PORT=587
EMAIL_USERNAME=CHANGE_ME_SMTP_ACCOUNT
EMAIL_PASSWORD=CHANGE_ME_SMTP_AUTH_CODE
EMAIL_FROM=CHANGE_ME_SENDER_EMAIL
EMAIL_CONFIG_SECRET=CHANGE_ME_RANDOM_EMAIL_CONFIG_SECRET

# 前端允许的跨域来源。生产环境建议改为实际域名，例如 https://yourdomain.com。
CORS_ALLOWED_ORIGINS=CHANGE_ME_CORS_ORIGIN

# 生产环境默认关闭危险的数据库导入能力，需要时再显式改为 true。
DATABASE_MAINTENANCE_ENABLED=false

# 生产环境默认关闭开发期性能切面日志。
TIME_ASPECT_ENABLED=false

# Nacos 服务注册中心
NACOS_PORT=8848
# Nacos 登录密码（默认 nacos，首次启动后建议通过控制台修改）
NACOS_PASSWORD=CHANGE_ME_NACOS_PASSWORD
# Nacos JWT 签名密钥，必须 Base64 编码，解码后 >=32 字节
# 生成方式: openssl rand -base64 32
NACOS_AUTH_TOKEN=SPhXUsw7QW36Rlkh3WQerl64iXc45ovUc/ABBkWOZpo=
NACOS_AUTH_IDENTITY_KEY=serverIdentity
NACOS_AUTH_IDENTITY_VALUE=CHANGE_ME_NACOS_IDENTITY
