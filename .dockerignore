# Root Docker build context ignore file.
# docker-compose.yml uses the project root as build context so the front Dockerfile
# can read deploy/nginx/default.conf and both images can be built from one place.

**/.git
**/.idea
**/.vscode
**/node_modules
**/dist
**/dist-ssr
**/target
**/logs
**/*.log
**/*.zip
**/.env.local
**/.env.*.local

.claude
.trae
.codex-git-front
git-scratch-*
old

redis-server.exe - 快捷方式.lnk

# 敏感文件与构建无关文件
.env
.env.*
!.env.example
ISSUE/
sql/schema_*.sql

# 运行时数据与备份：构建上下文是仓库根，若不排除，
# `docker compose build` 会把整个 MySQL/Redis 数据目录与全库备份发给 daemon（还可能进层缓存）。
# 见审计 2.3.4。
data/
backups/
docs/
